{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mock",
      "type": "process",
      "command": "python",
      "args": [
        "${config:mockshadow.executable}",
        "mock",
        "--details"
      ],
      "problemMatcher": []
    },
    {
      "label": "Force mocks",
      "type": "process",
      "command": "python",
      "args": [
        "${config:mockshadow.executable}",
        "mock",
        "--force"
      ],
      "problemMatcher": []
    },
    {
      "label": "Audit mocks",
      "type": "process",
      "command": "python",
      "args": [
        "${config:mockshadow.executable}",
        "audit",
        "--report",
        "reports/audit.json"
      ],
      "problemMatcher": []
    }
  ]
}
